{
  "name": "flexytracker-overlay",
  "version": "1.0.0",
  "description": "Ventana overlay siempre visible para FlexyTracker",
  "main": "main.js",
  "author": "FlexyTracker",
  "license": "MIT",
  "scripts": {"start": "electron .", "dist": "electron-builder --win"},
  "devDependencies": {"electron": "33.4.11", "electron-builder": "25.1.8"},
  "build": {
    "appId": "com.flexytracker.overlay",
    "productName": "FlexyTracker Overlay",
    "directories": {"output": "dist"},
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": {"target": [{"target": "nsis", "arch": ["x64"]}], "artifactName": "FlexyTracker-Overlay-Setup-${version}.${ext}"},
    "nsis": {"oneClick": true, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true}
  }
}
